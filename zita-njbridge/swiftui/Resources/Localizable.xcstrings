    "1 500 octets sur un réseau ordinaire. Des paquets plus grands augmentent la gigue sur un réseau partagé.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1,500 bytes on an ordinary network. Larger packets increase jitter on a shared network."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1.500 Byte in einem gewöhnlichen Netzwerk. Größere Pakete erhöhen den Jitter in einem gemeinsam genutzten Netzwerk."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "1.500 byte su una rete ordinaria. Pacchetti più grandi aumentano il jitter su una rete condivisa."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "1500 bytes en una red ordinaria. Los paquetes más grandes aumentan el jitter en una red compartida."
          }
        }
      }
    },
    "1 : le réseau local seulement.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1: the local network only."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1: nur das lokale Netzwerk."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "1: solo la rete locale."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "1: solo la red local."
          }
        }
      }
    },

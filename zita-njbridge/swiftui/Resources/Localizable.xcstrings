    "Ajoute de la latence, absorbe les retards du réseau. Par défaut : 10 ms.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds latency, absorbs network delays. Default: 10 ms."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhöht die Latenz, fängt Netzwerkverzögerungen auf. Standard: 10 ms."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunge latenza, assorbe i ritardi della rete. Predefinito: 10 ms."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade latencia, absorbe los retrasos de la red. Predeterminado: 10 ms."
          }
        }
      }
    },

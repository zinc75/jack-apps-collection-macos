    "Efface les branchements, ou remet chaque voie sur le port du même numéro de la carte son (voie 1 sur le port 1, voie 2 sur le port 2…).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clears the connections, or puts each channel back on the port of the same number of the sound card (channel 1 on port 1, channel 2 on port 2…)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht die Verbindungen oder legt jeden Kanal wieder auf den Port mit derselben Nummer der Soundkarte (Kanal 1 auf Port 1, Kanal 2 auf Port 2 …)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancella i collegamenti, oppure rimette ogni canale sulla porta dello stesso numero della scheda audio (canale 1 sulla porta 1, canale 2 sulla porta 2…)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borra las conexiones, o vuelve a poner cada canal en el puerto del mismo número de la tarjeta de sonido (canal 1 en el puerto 1, canal 2 en el puerto 2…)."
          }
        }
      }

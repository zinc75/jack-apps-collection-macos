          "stringUnit": {
            "state": "translated",
            "value": "Reception settings have changed: restart this direction to apply them."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Empfangseinstellungen wurden geändert: Starte diese Richtung neu, um sie anzuwenden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le impostazioni di ricezione sono cambiate: riavvia questo senso per applicarle."
          }
        },

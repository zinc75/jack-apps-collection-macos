    "Plus de voies": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More Channels"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mehr Kanäle"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",

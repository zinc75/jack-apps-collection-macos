    "24 bits": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "24-bit"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "24-Bit"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "24 bit"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "24 bits"
          }
        }
      }
    },
    "24 bits est le choix usuel. Flottant 32 bits conserve le format interne de JACK, avec un débit plus grand.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "24 bit is the usual choice. 32-bit float keeps the internal format of JACK, with a higher data rate."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "24 Bit ist die übliche Wahl. 32-Bit-Float behält das interne Format von JACK bei, mit höherer Datenrate."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "24 bit è la scelta abituale. Il float a 32 bit conserva il formato interno di JACK, con un flusso di dati maggiore."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "24 bits es la opción habitual. La coma flotante de 32 bits conserva el formato interno de JACK, con un caudal de datos mayor."
          }
        }
      }
    },

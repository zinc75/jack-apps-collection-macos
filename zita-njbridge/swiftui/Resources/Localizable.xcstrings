    "Des réglages d'envoi ont changé : redémarrez ce sens pour les appliquer.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sending settings have changed: restart this direction to apply them."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sendeeinstellungen wurden geändert: Starte diese Richtung neu, um sie anzuwenden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le impostazioni di invio sono cambiate: riavvia questo senso per applicarle."
          }
        },

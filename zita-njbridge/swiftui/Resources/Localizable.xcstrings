    "Marge insuffisante : avec une période JACK de %@ trames, un tampon supplémentaire de **%lld ms** ou plus est recommandé.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Margin too small: with a JACK period of %@ frames, an extra buffer of **%lld ms** or more is recommended."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reserve zu klein: Bei einer JACK-Periode von %@ Frames werden **%lld ms** Zusatzpuffer oder mehr empfohlen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Margine insufficiente: con un periodo JACK di %@ frame si consiglia un buffer aggiuntivo di **%lld ms** o più."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Margen insuficiente: con un periodo de JACK de %@ muestras se recomienda un búfer adicional de **%lld ms** o más."
          }
        }
      }
    },

          "stringUnit": {
            "state": "translated",
            "value": "Se han cambiado ajustes de recepción: reinicia este sentido para aplicarlos."
          }
        }
      }
    },
    "Des réglages ont changé : l'envoi doit redémarrer pour les appliquer. Le son est coupé un instant.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings have changed: sending must restart to apply them. The sound cuts out for a moment."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungen wurden geändert: Das Senden muss neu starten, um sie anzuwenden. Der Ton setzt kurz aus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le impostazioni sono cambiate: l'invio deve riavviarsi per applicarle. L'audio si interrompe per un istante."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se han cambiado ajustes: el envío debe reiniciarse para aplicarlos. El sonido se corta un instante."
          }
        }
      }
    },
    "Des réglages ont changé : la réception doit redémarrer pour les appliquer. Le son est coupé un instant.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings have changed: reception must restart to apply them. The sound cuts out for a moment."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungen wurden geändert: Der Empfang muss neu starten, um sie anzuwenden. Der Ton setzt kurz aus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le impostazioni sono cambiate: la ricezione deve riavviarsi per applicarle. L'audio si interrompe per un istante."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se han cambiado ajustes: la recepción debe reiniciarse para aplicarlos. El sonido se corta un instante."
          }
        }
      }
    },
    "Des réglages ont changé : la réception et l'envoi doivent redémarrer pour les appliquer. Le son est coupé un instant.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings have changed: reception and sending must restart to apply them. The sound cuts out for a moment."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungen wurden geändert: Empfang und Senden müssen neu starten, um sie anzuwenden. Der Ton setzt kurz aus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le impostazioni sono cambiate: la ricezione e l'invio devono riavviarsi per applicarle. L'audio si interrompe per un istante."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se han cambiado ajustes: la recepción y el envío deben reiniciarse para aplicarlos. El sonido se corta un instante."
          }
        }
      }
    },

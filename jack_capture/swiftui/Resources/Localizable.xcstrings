    "Réserve de disque" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Festplattenreserve"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disk reserve"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reserva de disco"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riserva di disco"
          }
        }
      }
    },
    "Place libre que le disque garde, en gigaoctets. En dessous, un enregistrement ne démarre pas, et celui qui tourne est arrêté et son fichier refermé. 0 : aucune limite." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Freier Platz, den die Festplatte behält, in Gigabyte. Darunter startet keine Aufnahme, und eine laufende wird gestoppt und ihre Datei geschlossen. 0: keine Grenze."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Free space the disk keeps, in gigabytes. Below it a recording does not start, and one that is running is stopped and its file closed. 0: no limit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espacio libre que conserva el disco, en gigabytes. Por debajo, una grabación no se inicia, y la que está en curso se detiene y su archivo se cierra. 0: sin límite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spazio libero che il disco conserva, in gigabyte. Al di sotto, una registrazione non parte e quella in corso viene fermata e il suo file chiuso. 0: nessun limite."
          }
        }
      }
    },
    "Moins de %lld Go libres sur ce disque : l'enregistrement s'arrêterait aussitôt. La réserve se règle dans la page Avancé." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weniger als %lld GB frei auf dieser Festplatte: Die Aufnahme würde sofort stoppen. Die Reserve wird auf der Seite „Erweitert“ eingestellt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Less than %lld GB free on this disk: the recording would stop at once. The reserve is set in the Advanced page."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menos de %lld GB libres en este disco: la grabación se detendría de inmediato. La reserva se ajusta en la página Avanzado."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meno di %lld GB liberi su questo disco: la registrazione si fermerebbe subito. La riserva si imposta nella pagina Avanzate."
          }
        }
      }
    },
    "Un autre enregistrement écrit déjà dans ce fichier. Changer le nom, ou activer la numérotation." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine andere Aufnahme schreibt bereits in diese Datei. Den Namen ändern oder die Nummerierung aktivieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Another recording is already writing to this file. Change the name, or turn numbering on."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otra grabación ya escribe en este archivo. Cambie el nombre o active la numeración."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un'altra registrazione sta già scrivendo in questo file. Cambia il nome o attiva la numerazione."
          }
        }
      }
    },
    "Il reste de la place pour environ %lld min d'enregistrement." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es ist noch Platz für etwa %lld Min. Aufnahme."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There is room for about %lld min of recording."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Queda espacio para unos %lld min de grabación."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resta spazio per circa %lld min di registrazione."
          }
        }
      }
    },

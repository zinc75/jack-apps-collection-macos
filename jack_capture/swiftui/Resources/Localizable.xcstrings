          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The JACK server stopped during the recording. The file holds what was recorded until then."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",

          }
        }
      }
    },
    "Les connexions sont laissées au patchbay : il n'y a pas de sources à prévisualiser." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Verbindungen bleiben dem Patchbay überlassen: es gibt keine Quellen zur Vorschau."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The connections are left to the patchbay: there are no sources to preview."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las conexiones se dejan al patchbay: no hay fuentes que previsualizar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le connessioni sono lasciate al patchbay: non ci sono sorgenti da mostrare in anteprima."
          }
        }
      }
    },
    "Les sources d'une même voie sont additionnées, sans réglage de niveau. En entiers, un dépassement de 0 dBFS écrête." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Quellen eines Kanals werden ohne Pegelregelung addiert. Bei Ganzzahlformaten wird ein Überschreiten von 0 dBFS abgeschnitten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sources in the same channel are added together, with no level control. In integer formats, going over 0 dBFS clips."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las fuentes de un mismo canal se suman, sin control de nivel. Con enteros, superar 0 dBFS recorta."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le sorgenti dello stesso canale sono sommate, senza regolazione di livello. Con gli interi, un superamento di 0 dBFS satura."
          }
        }
      }
    },
    "Les sources d'une même voie sont additionnées, sans réglage de niveau. En virgule flottante, un dépassement est conservé." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Quellen eines Kanals werden ohne Pegelregelung addiert. Bei Fließkomma bleibt eine Übersteuerung erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sources in the same channel are added together, with no level control. In floating point, an overshoot is kept."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las fuentes de un mismo canal se suman, sin control de nivel. En coma flotante, un exceso se conserva."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le sorgenti dello stesso canale sono sommate, senza regolazione di livello. In virgola mobile, un superamento viene conservato."
          }
        }
      }
    },
    "Les voies %@ n'ont pas de source." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kanäle %@ haben keine Quelle."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Channels %@ have no source."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los canales %@ no tienen fuente."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I canali %@ non hanno una sorgente."
          }
        }
      }
    },
    "Les voies concernées seront enregistrées en silence." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die betroffenen Kanäle werden stumm aufgenommen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The channels concerned will be recorded silent."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los canales afectados se grabarán en silencio."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I canali interessati saranno registrati muti."
          }
        }
      }
    },
    "Les voies sans source seront enregistrées en silence." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanäle ohne Quelle werden als Stille aufgenommen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Channels without a source will be recorded as silence."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los canales sin fuente se grabarán en silencio."
          }
        },

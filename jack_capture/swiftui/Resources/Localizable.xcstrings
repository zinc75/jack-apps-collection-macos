          "stringUnit" : {
            "state" : "translated",
            "value" : "I canali senza sorgente saranno registrati in silenzio."
          }
        }
      }
    },
    "Les vumètres sont désactivés. Ils se règlent dans Configuration, Affichage." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Pegelanzeigen sind ausgeschaltet. Sie lassen sich unter Konfiguration, Anzeige einstellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The meters are switched off. They are set in Configuration, Display."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los vúmetros están desactivados. Se ajustan en Configuración, Pantalla."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I vumetri sono disattivati. Si regolano in Configurazione, Visualizzazione."

    "Il ne reste que %@ sur ce disque : trop peu pour enregistrer. Libérer de la place, ou choisir un autre dossier." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf diesem Datenträger sind nur noch %@ frei: zu wenig zum Aufnehmen. Platz schaffen oder einen anderen Ordner wählen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only %@ is left on this disk: too little to record. Free up some space, or choose another folder."

          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il server JACK si è fermato durante la registrazione. Il file contiene quanto registrato fino a quel momento."
          }
        }
      }
    },
    "Le volume « %@ » n'est pas monté. Le brancher, ou choisir un autre dossier." : {
      "localizations" : {

    "Cette session a déjà des réglages." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Sitzung hat bereits Einstellungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This session already has settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta sesión ya tiene ajustes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa sessione ha già delle impostazioni."
          }
        }
      }
    },
    "Ouvrir une nouvelle session, ou repartir de zéro dans celle-ci ?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine neue Sitzung öffnen oder in dieser neu beginnen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open a new session, or start over in this one?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Abrir una nueva sesión o empezar de cero en esta?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprire una nuova sessione o ricominciare da zero in questa?"
          }
        }
      }
    },
    "Remplacer cette session" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Sitzung ersetzen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Replace this session"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reemplazar esta sesión"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sostituisci questa sessione"
          }
        }
      }
    },
    "Un enregistrement est armé." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Aufnahme ist scharf geschaltet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A recording is armed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay una grabación armada."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una registrazione è armata."
          }
        }
      }
    },
    "Un enregistrement est en cours." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Aufnahme läuft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A recording is in progress."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay una grabación en curso."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una registrazione è in corso."
          }
        }
      }
    },
    "Vous pouvez fermer la fenêtre et laisser l'enregistrement continuer : il reste dans la barre des menus, d'où vous pourrez rouvrir la fenêtre ou l'arrêter. Si vous l'arrêtez, le fichier est refermé proprement." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können das Fenster schließen und die Aufnahme weiterlaufen lassen: Sie bleibt in der Menüleiste, von wo Sie das Fenster wieder öffnen oder die Aufnahme stoppen können. Beim Stoppen wird die Datei ordnungsgemäß geschlossen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can close the window and let the recording go on: it stays in the menu bar, where you can reopen the window or stop it. If you stop it, the file is closed properly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede cerrar la ventana y dejar que la grabación continúe: permanece en la barra de menús, desde donde podrá reabrir la ventana o detenerla. Si la detiene, el archivo se cierra correctamente."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi chiudere la finestra e lasciare proseguire la registrazione: resta nella barra dei menu, da dove potrai riaprire la finestra o fermarla. Se la fermi, il file viene chiuso correttamente."
          }
        }
      }
    },
    "Impossible de démarrer" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {

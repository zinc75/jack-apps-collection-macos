+/* Keeps, for each channel, the highest sample of this cycle if it is higher than the one kept. */
+static void peaks_update(struct player *d, jack_nframes_t nframes)
+{
+	int j;
+	for (j = 0; j < d->channels; j++) {
+		float m = 0;
+		jack_nframes_t i;
+		for (i = 0; i < nframes; i++) {
+			float a = fabsf(d->out[j][i]);
+			if (a > m) {
+				m = a;
+			}
+		}
+		uint32_t bits;
+		memcpy(&bits, &m, sizeof(bits));
+		uint32_t kept = __atomic_load_n(&d->peak_bits[j], __ATOMIC_RELAXED);
+		while (bits > kept &&
+			!__atomic_compare_exchange_n(&d->peak_bits[j], &kept, bits, true, __ATOMIC_RELAXED, __ATOMIC_RELAXED)) {
+		}
+	}
+}

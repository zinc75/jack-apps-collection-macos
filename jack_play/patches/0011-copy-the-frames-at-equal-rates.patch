Subject: copy the frames when the file and the server have the same rate

signal_proc() always passes the audio through libsamplerate, also when the
ratio is 1.0, so the output is not the file: the largest difference is 0.0375
(about -28 dBFS) with the default converter on a test signal with high
frequency content, and after a seek the filter rings for about ten frames.
When src_ratio is exactly 1.0 (equal rates and no -r) the frames now go from
the ring buffer to the output as they are. The end of the file is when the disk
thread has finished and the ring buffer is empty. Nothing changes when the
rates differ. Proposed to the author.

--- a/cmd/rju-play.c
+++ b/cmd/rju-play.c
@@ -373,21 +373,43 @@ int signal_proc(jack_nframes_t nframes, void *PTR)
 		}
 	}
 
-	/* Get data from sample rate converter, this returns the number of
-	   frames acquired. */
-	long err = src_callback_read(d->src,
-		d->o.src_ratio,
-		(long)nframes - offset,
-		d->j_buffer);
-	die_when(err == 0,
-		"rju-play: sample rate converter failed: %s\n",
-		src_strerror(src_error(d->src)));
-	d->player_frame_count += err;
-
-	/* Everything is played once the converter has produced as many frames
-	   as the reader read, scaled by the sample rate conversion ratio. */
-	if (atomic_load_explicit(&d->reader_at_eof, memory_order_acquire)
-		&& d->player_frame_count >= (i64)(d->reader_frame_count * d->o.src_ratio)) {
+	/* When the file and the server have the same sample rate, and no
+	   resampling ratio was asked for, the frames go from the ring buffer
+	   to the output as they are: the converter would still filter them,
+	   and the output would not be the file. */
+	bool copy = d->o.src_ratio == 1.0;
+	bool reader_at_eof = atomic_load_explicit(&d->reader_at_eof, memory_order_acquire);
+	bool finished = false;
+	long err;
+	if (copy) {
+		err = (long)ringbuffer_read(d->rb,
+			(char *)d->j_buffer,
+			((size_t)nframes - offset) * d->channels * sizeof(float));
+		err /= d->channels * sizeof(float);
+		d->reader_frame_count += err;
+		d->player_frame_count += err;
+
+		/* Everything is played once the disk thread has finished and
+		   the ring buffer is empty. */
+		finished = reader_at_eof && ringbuffer_read_space(d->rb) == 0;
+	} else {
+		/* Get data from sample rate converter, this returns the number of
+		   frames acquired. */
+		err = src_callback_read(d->src,
+			d->o.src_ratio,
+			(long)nframes - offset,
+			d->j_buffer);
+		die_when(err == 0,
+			"rju-play: sample rate converter failed: %s\n",
+			src_strerror(src_error(d->src)));
+		d->player_frame_count += err;
+
+		/* Everything is played once the converter has produced as many frames
+		   as the reader read, scaled by the sample rate conversion ratio. */
+		finished = reader_at_eof
+			&& d->player_frame_count >= (i64)(d->reader_frame_count * d->o.src_ratio);
+	}
+	if (finished) {
 		if (d->o.control) {
 			d->ended = 1;
 			/* After the end the player is paused: a seek then moves without playing. */
@@ -414,7 +436,9 @@ int signal_proc(jack_nframes_t nframes, void *PTR)
 	   should set a flag and have another thread take appropriate
 	   action. */
 	if (err < (long)nframes - offset) {
-		fprintf(stderr, "rju-play: disk thread late (%ld < %d)\n", err, nframes - offset);
+		if (!(copy && reader_at_eof)) {
+			fprintf(stderr, "rju-play: disk thread late (%ld < %d)\n", err, nframes - offset);
+		}
 		for (i = offset + err; i < nframes; i++) {
 			for (j = 0; j < d->channels; j++) {
 				d->out[j][i] = 0.0;

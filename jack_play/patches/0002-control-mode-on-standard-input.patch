+/* Control mode.  Commands arrive on standard input, one per line:
+
+     play        play, or go on playing (from the start if the end had been reached)
+     pause       stop playing, the position is kept
+     seek N      go to frame N of the file (a frame of the file, not of the server)
+     quit        leave
+
+   What the program says on standard output, one line each:
+
+     ready CHANNELS FILE-RATE SERVER-RATE FRAMES     once, when the ports exist
+     pos FRAME STATE                                 as it changes, and twice a second
+                                                     (STATE is paused, playing or ended)
+
+   Any other line is information.  The end of the input is a quit. */
+static void control_print(struct player *d, i64 *last_pos, int *last_state, struct timespec *last_time)
+{
+	i64 pos = __atomic_load_n(&d->pub_pos, __ATOMIC_ACQUIRE);
+	int state = __atomic_load_n(&d->pub_state, __ATOMIC_ACQUIRE);
+	struct timespec now;
+	clock_gettime(CLOCK_MONOTONIC, &now);
+	double since = (double)(now.tv_sec - last_time->tv_sec) + (double)(now.tv_nsec - last_time->tv_nsec) / 1e9;
+	if (pos != *last_pos || state != *last_state || since >= 0.5) {
+		static const char *names[] = { "paused", "playing", "ended" };
+		printf("pos %ld %s\n", (long)pos, names[state]);
+		fflush(stdout);
+		*last_pos = pos;
+		*last_state = state;
+		*last_time = now;
+	}
+}
+
+static void control_command(struct player *d, const char *line)
+{
+	long n;
+	if (strcmp(line, "play") == 0) {
+		if (__atomic_load_n(&d->pub_state, __ATOMIC_ACQUIRE) == 2) {
+			__atomic_store_n(&d->ctl_seek, (i64)0, __ATOMIC_RELEASE);
+		}
+		__atomic_store_n(&d->ctl_play, 1, __ATOMIC_RELEASE);
+	} else if (strcmp(line, "pause") == 0) {
+		__atomic_store_n(&d->ctl_play, 0, __ATOMIC_RELEASE);
+	} else if (sscanf(line, "seek %ld", &n) == 1) {
+		__atomic_store_n(&d->ctl_seek, (i64)(n < 0 ? 0 : n), __ATOMIC_RELEASE);
+	} else if (strcmp(line, "quit") == 0) {
+		__atomic_store_n(&d->quit, 1, __ATOMIC_RELEASE);
+	}
+}
+
+static void control_loop(struct player *d)
+{
+	char buf[256];
+	size_t fill = 0;
+	i64 last_pos = -1;
+	int last_state = -1;
+	struct timespec last_time;
+	clock_gettime(CLOCK_MONOTONIC, &last_time);
+	last_time.tv_sec -= 1;
+	while (!stopping(d)) {
+		struct pollfd p = { 0, POLLIN, 0 };
+		int r = poll(&p, 1, 33);
+		if (r > 0 && (p.revents & (POLLIN | POLLHUP))) {
+			ssize_t n = read(0, buf + fill, sizeof(buf) - fill - 1);
+			if (n <= 0) {
+				break; /* the program that controls us is gone */
+			}
+			fill += (size_t)n;
+			buf[fill] = 0;
+			char *start = buf, *nl;
+			while ((nl = strchr(start, '\n')) != NULL) {
+				*nl = 0;
+				control_command(d, start);
+				start = nl + 1;
+			}
+			fill = (size_t)(buf + fill - start);
+			memmove(buf, start, fill);
+			if (fill >= sizeof(buf) - 1) {
+				fill = 0; /* a line that is too long is dropped */
+			}
+		}
+		control_print(d, &last_pos, &last_state, &last_time);
+	}
+}

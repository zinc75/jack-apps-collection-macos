    "Arrêtez la lecture (ou mettez-la en pause) pour changer ce réglage." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiedergabe anhalten (oder pausieren), um diese Einstellung zu ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stop playback (or pause it) to change this setting."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detén la reproducción (o ponla en pausa) para cambiar este ajuste."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ferma la riproduzione (o mettila in pausa) per cambiare questa impostazione."
          }
        }
      }
    },
    "Arrêtez la lecture, ou ouvrez ce fichier, pour modifier ses branchements." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiedergabe anhalten oder diese Datei öffnen, um ihre Verbindungen zu ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stop playback, or open this file, to change its connections."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detén la reproducción, o abre este archivo, para cambiar sus conexiones."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ferma la riproduzione, o apri questo file, per modificarne le connessioni."
          }
        }
      }
    },

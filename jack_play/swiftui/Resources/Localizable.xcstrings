            "state" : "translated",
            "value" : "Wird verwendet, wenn die Abtastrate der Datei von der des JACK-Servers abweicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used when the sample rate of the file differs from that of the JACK server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa cuando la frecuencia del archivo difiere de la del servidor JACK."

    "Les boutons de la fenêtre démarrent, arrêtent et déplacent le transport. Désactivé, la fenêtre ne fait que suivre." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Tasten des Fensters starten, stoppen und verschieben den Transport. Ausgeschaltet folgt das Fenster nur."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The buttons of the window start, stop and move the transport. When off, the window only follows."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los botones de la ventana inician, detienen y mueven el transporte. Desactivado, la ventana solo lo sigue."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I pulsanti della finestra avviano, fermano e spostano il transport. Se disattivato, la finestra si limita a seguirlo."
          }
        }
      }
    },
    "Les boutons ne commandent pas le transport" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Tasten steuern den Transport nicht"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The buttons do not control the transport"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los botones no controlan el transporte"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I pulsanti non controllano il transport"
          }
        }
      }
    },
    "Les fichiers se lisent l'un après l'autre, sans coupure. Chacun garde ses propres branchements." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Dateien laufen nacheinander, ohne Lücke. Jede behält ihre eigenen Verbindungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The files play one after the other, without a gap. Each keeps its own connections."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los archivos se reproducen uno tras otro, sin cortes. Cada uno conserva sus propias conexiones."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I file si riproducono uno dopo l'altro, senza interruzioni. Ognuno mantiene le proprie connessioni."
          }
        }
      }
    },

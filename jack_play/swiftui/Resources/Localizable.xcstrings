            "value" : "Indipendente"
          }
        }
      }
    },
    "Indépendant : le fichier se lit seul. Transport JACK : il démarre, s'arrête et se déplace avec le transport partagé par les autres clients." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unabhängig: Die Datei wird für sich abgespielt. JACK-Transport: Sie startet, stoppt und springt mit dem Transport, den die anderen Clients teilen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Independent: the file plays on its own. JACK transport: it starts, stops and moves with the transport shared by the other clients."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Independiente: el archivo se reproduce solo. Transporte JACK: arranca, se detiene y se mueve con el transporte compartido por los demás clientes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indipendente: il file viene riprodotto da solo. Transport JACK: parte, si ferma e si sposta con il transport condiviso dagli altri client."
          }
        }
      }
    },

    },
    "Plus il est grand, plus la lecture résiste aux disques lents, au prix d'un départ plus long. Le programme le relève seul s'il est trop petit pour la période du serveur JACK." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je größer er ist, desto besser kommt die Wiedergabe mit langsamen Festplatten zurecht, bei längerem Start. Das Programm erhöht ihn selbst, wenn er für die Periode des JACK-Servers zu klein ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The larger it is, the better playback copes with slow disks, at the cost of a longer start. The program raises it by itself if it is too small for the period of the JACK server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuanto mayor es, mejor resiste la reproducción los discos lentos, a costa de un arranque más largo. El programa lo aumenta solo si es demasiado pequeño para el periodo del servidor JACK."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Più è grande, meglio la riproduzione regge i dischi lenti, a costo di una partenza più lunga. Il programma lo aumenta da solo se è troppo piccolo per il periodo del server JACK."
          }
        }
      }
    },
    "Plus rapide" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schnellste"
          }

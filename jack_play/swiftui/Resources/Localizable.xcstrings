          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No JACK server is running. Playback starts as soon as there is one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay ningún servidor JACK en marcha. La reproducción empieza en cuanto haya uno."

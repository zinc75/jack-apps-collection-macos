    "Aucun serveur JACK n'est démarré." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es läuft kein JACK-Server."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No JACK server is running."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay ningún servidor JACK en marcha."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun server JACK è in esecuzione."
          }
        }
      }
    },
    "Aucun serveur JACK n'est démarré. La lecture commence dès qu'il l'est." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es läuft kein JACK-Server. Die Wiedergabe beginnt, sobald einer läuft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No JACK server is running. Playback starts as soon as there is one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay ningún servidor JACK en marcha. La reproducción empieza en cuanto haya uno."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun server JACK è in esecuzione. La riproduzione inizia appena ce n'è uno."
          }
        }
      }
    },

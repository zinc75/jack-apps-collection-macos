    "Indépendant" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unabhängig"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Independent"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Independiente"
          }

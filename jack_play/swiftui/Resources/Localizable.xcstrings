    "Sans effet avec le transport JACK : le transport décide. Passez en mode Indépendant pour répéter." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne Wirkung mit dem JACK-Transport: Der Transport entscheidet. In den Modus „Unabhängig“ wechseln, um zu wiederholen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No effect with the JACK transport: the transport decides. Switch to Independent mode to repeat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin efecto con el transporte JACK: decide el transporte. Pasa al modo Independiente para repetir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun effetto con il trasporto JACK: decide il trasporto. Passa alla modalità Indipendente per ripetere."
          }
        }
      }
    },
    "Sans effet avec le transport JACK : passez en mode Indépendant pour répéter." : {

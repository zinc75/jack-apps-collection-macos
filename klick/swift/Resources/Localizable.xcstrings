            "value": "revisione"
          }
        }
      }
    },
    "Aucun port d'entrée dans le serveur JACK.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No input port in the JACK server."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Eingangsport im JACK-Server."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna porta d'ingresso nel server JACK."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningún puerto de entrada en el servidor JACK."
          }
        }
      }
    },
    "Ce que JACK annonce pour la sortie, une fois reliée : les voyants en tiennent compte.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What JACK reports for the output once it is connected: the beat lights take it into account."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was JACK für den Ausgang meldet, sobald er verbunden ist: die Leuchtanzeigen berücksichtigen es."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quello che JACK indica per l'uscita una volta collegata: le spie ne tengono conto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que JACK indica para la salida una vez conectada: los indicadores lo tienen en cuenta."
          }
        }
      }
    },
    "Celle du serveur JACK : Klick joue à ce rythme, sans conversion.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The rate of the JACK server: Klick plays at that rate, with no conversion."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Rate des JACK-Servers: Klick spielt mit dieser Rate, ohne Umrechnung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La frequenza del server JACK: Klick suona a questa frequenza, senza conversione."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La frecuencia del servidor JACK: Klick suena a esa frecuencia, sin conversión."
          }
        }
      }
    },

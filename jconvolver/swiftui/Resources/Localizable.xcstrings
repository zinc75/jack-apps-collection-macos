    "Fichier et voie, gain, retard, début et longueur. Elle disparaît pendant une sélection ou quand ⌘ ou ⇧ est enfoncé." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datei und Kanal, Gain, Verzögerung, Anfang und Länge. Sie verschwindet bei einer Auswahl oder wenn ⌘ oder ⇧ gedrückt ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "File and channel, gain, delay, start and length. It disappears during a selection or when ⌘ or ⇧ is held down."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archivo y canal, ganancia, retardo, inicio y longitud. Desaparece durante una selección o cuando se mantiene pulsado ⌘ o ⇧."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "File e canale, guadagno, ritardo, inizio e lunghezza. Scompare durante una selezione o quando ⌘ o ⇧ è premuto."
          }
        }
      }
    },

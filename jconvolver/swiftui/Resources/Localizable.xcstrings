    "La compensation de latence retire %lld échantillons au début de « %@ », qui n'en a que %lld : cette réponse impulsionnelle restera muette. Donnez-lui un retard, ou baissez la compensation." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Latenzausgleich entfernt %lld Samples vom Anfang von „%@“, das nur %lld hat: Diese Impulsantwort bleibt stumm. Gib ihr eine Verzögerung oder verringere den Ausgleich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The latency compensation removes %lld samples from the start of “%@”, which has only %lld: this impulse response will stay silent. Give it a delay, or lower the compensation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La compensación de latencia elimina %lld muestras al principio de «%@», que solo tiene %lld: esta respuesta al impulso quedará muda. Dale un retardo, o baja la compensación."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La compensazione della latenza toglie %lld campioni all'inizio di «%@», che ne ha solo %lld: questa risposta all'impulso resterà muta. Dalle un ritardo, o abbassa la compensazione."
          }
        }
      }
    },
    "La compensation de latence supprime ou raccourcit %lld réponses impulsionnelles." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Latenzausgleich entfernt oder kürzt %lld Impulsantworten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The latency compensation removes or shortens %lld impulse responses."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La compensación de latencia elimina o acorta %lld respuestas al impulso."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La compensazione della latenza rimuove o accorcia %lld risposte all'impulso."
          }
        }
      }
    },
    "La conversion de « %@ » a échoué : %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Konvertierung von „%@“ ist fehlgeschlagen: %@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conversion of “%@” failed: %@"
          }
        },
        "es" : {

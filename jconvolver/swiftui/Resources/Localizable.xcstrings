    "La longueur maximale (%lld) est plus courte que la plus longue réponse impulsionnelle (%lld) : elle sera tronquée." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die maximale Länge (%lld) ist kürzer als die längste Impulsantwort (%lld): Sie wird gekürzt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The maximum length (%lld) is shorter than the longest impulse response (%lld): it will be truncated."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La longitud máxima (%lld) es menor que la respuesta al impulso más larga (%lld): se truncará."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La lunghezza massima (%lld) è inferiore alla risposta all'impulso più lunga (%lld): verrà troncata."
          }
        }
      }
    },
    "La part des paires qui ont une réponse impulsionnelle, de 0 à 1. Calculée : %@." : {

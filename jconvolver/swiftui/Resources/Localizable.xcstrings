    "Des fichiers de mêmes noms sont dans le dossier du fichier de configuration : « %@ ». Choisissez ceux à prendre ; la configuration les nommera à partir de son propre dossier." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dateien mit denselben Namen liegen im Ordner der Konfigurationsdatei: „%@“. Wähle die zu übernehmenden aus; die Konfiguration benennt sie ausgehend von ihrem eigenen Ordner."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Files with the same names are in the folder of the configuration file: “%@”. Choose the ones to take; the configuration will name them from its own folder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay archivos con los mismos nombres en la carpeta del archivo de configuración: “%@”. Selecciona los que quieras usar; la configuración los nombrará a partir de su propia carpeta."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "File con gli stessi nomi si trovano nella cartella del file di configurazione: «%@». Scegli quelli da prendere; la configurazione li indicherà a partire dalla propria cartella."
          }
        }
      }
    },

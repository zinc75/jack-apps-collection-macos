    "Montre le retard de groupe en millisecondes, calculé à partir de la réponse impulsionnelle, à la place de la phase." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt die aus der Impulsantwort berechnete Gruppenlaufzeit in Millisekunden anstelle der Phase."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows the group delay in milliseconds, computed from the impulse response, in place of the phase."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra el retardo de grupo en milisegundos, calculado a partir de la respuesta al impulso, en lugar de la fase."
          }
        },
        "it" : {
          "stringUnit" : {

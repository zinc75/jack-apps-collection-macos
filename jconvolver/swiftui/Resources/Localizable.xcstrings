    "Remplacer" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ersetzen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Replace"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reemplazar"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sostituisci"
          }
        }
      }
    },
    "Remplacer : la valeur prend la place de celle de chaque réponse impulsionnelle. Décaler : elle s'ajoute à celle de chaque réponse impulsionnelle, les écarts sont conservés." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ersetzen: Der Wert tritt an die Stelle des Wertes jeder Impulsantwort. Verschieben: Er wird zum Wert jeder Impulsantwort addiert, die Unterschiede bleiben erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Replace: the value takes the place of that of each impulse response. Shift: it is added to that of each impulse response, the differences are kept."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reemplazar: el valor ocupa el lugar del de cada respuesta al impulso. Desplazar: se suma al de cada respuesta al impulso, se conservan las diferencias."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sostituisci: il valore prende il posto di quello di ogni risposta all'impulso. Sposta: si aggiunge a quello di ogni risposta all'impulso, le differenze vengono mantenute."
          }
        }
      }
    },

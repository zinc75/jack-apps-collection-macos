    "Retard" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verzögerung"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delay"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retardo"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ritardo"
          }
        }
      }
    },
    "Retard compris, début ignoré retiré, fin tronquée par la longueur choisie. Ce n'est pas la longueur des fichiers." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verzögerung eingeschlossen, ignorierter Anfang entfernt, Ende durch die ausgewählte Länge gekürzt. Das ist nicht die Länge der Dateien."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delay included, ignored start removed, end cut by the selected length. It is not the length of the files."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con el retardo incluido, sin el inicio ignorado y con el final recortado por la longitud seleccionada. No es la longitud de los archivos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ritardo incluso, inizio ignorato rimosso, fine troncata dalla lunghezza selezionata. Non è la lunghezza dei file."
          }
        }
      }
    },
    "Retard compris, début ignoré retiré, fin tronquée par la longueur choisie. Ce n'est pas la longueur des fichiers. Au plus 1 048 576 échantillons." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verzögerung eingeschlossen, ignorierter Anfang entfernt, Ende durch die ausgewählte Länge gekürzt. Das ist nicht die Länge der Dateien. Höchstens 1 048 576 Samples."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delay included, ignored start removed, end cut by the selected length. It is not the length of the files. At most 1,048,576 samples."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con el retardo incluido, sin el inicio ignorado y con el final recortado por la longitud seleccionada. No es la longitud de los archivos. Como máximo 1 048 576 muestras."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ritardo incluso, inizio ignorato rimosso, fine troncata dalla lunghezza selezionata. Non è la lunghezza dei file. Al massimo 1 048 576 campioni."
          }
        }
      }
    },
    "Retard de groupe" : {
      "localizations" : {
        "de" : {

          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The files do not all have the same rate (%@ Hz): an audio file has only one. Convert them first."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los archivos no tienen todos la misma frecuencia (%@ Hz): un archivo de audio solo tiene una. Conviértelos primero."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I file non hanno tutti la stessa frequenza (%@ Hz): un file audio ne ha una sola. Convertili prima."

    "Ces noms sont ceux des ports JACK (/input/name et /output/name) et des lignes et colonnes de la matrice. Chaque nom est unique, entrées et sorties confondues. Un champ vide garde le nom par défaut." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Namen sind die der JACK-Ports (/input/name und /output/name) sowie der Zeilen und Spalten der Matrix. Jeder Name ist eindeutig, Ein- und Ausgänge zusammengenommen. Ein leeres Feld behält den Standardnamen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These names are those of the JACK ports (/input/name and /output/name) and of the rows and columns of the matrix. Each name is unique, inputs and outputs alike. An empty field keeps the default name."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos nombres son los de los puertos JACK (/input/name y /output/name) y los de las filas y columnas de la matriz. Cada nombre es único, entradas y salidas juntas. Un campo vacío conserva el nombre predeterminado."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questi nomi sono quelli delle porte JACK (/input/name e /output/name) e delle righe e colonne della matrice. Ogni nome è unico, tra ingressi e uscite. Un campo vuoto mantiene il nome predefinito."
          }
        }
      }
    },
    "Ces noms sont portés plusieurs fois : %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Namen werden mehrfach verwendet: %@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These names are used several times: %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos nombres se usan varias veces: %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questi nomi sono usati più volte: %@."
          }
        }
      }
    },

          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The delay (%lld) must be at least %lld for this Hilbert filter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El retardo (%lld) debe ser al menos %lld para este filtro de Hilbert."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il ritardo (%lld) deve essere almeno %lld per questo filtro di Hilbert."
          }
        }
      }
    },
    "Le résidu : la différence des deux spectres, par douzièmes d'octave, dans la vue Fréquence" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",

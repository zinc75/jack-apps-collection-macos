    "La voie %lld de %@ est aussi utilisée par %lld autres réponses (%@%@). Elles gardent le fichier d'origine : seule celle-ci utilisera le nouveau fichier." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanal %lld von %@ wird auch von %lld anderen Antworten verwendet (%@%@). Sie behalten die Originaldatei: Nur diese verwendet die neue Datei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Channel %lld of %@ is also used by %lld other responses (%@%@). They keep the original file: only this one will use the new file."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El canal %lld de %@ también lo usan otras %lld respuestas (%@%@). Estas conservan el archivo original: solo esta usará el nuevo archivo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il canale %lld di %@ è usato anche da altre %lld risposte (%@%@). Queste mantengono il file originale: solo questa userà il nuovo file."
          }
        }
      }
    },
    "La voie %lld de %@ est aussi utilisée par une autre réponse (%@). Elle garde le fichier d'origine : seule celle-ci utilisera le nouveau fichier." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanal %lld von %@ wird auch von einer anderen Antwort verwendet (%@). Sie behält die Originaldatei: Nur diese verwendet die neue Datei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Channel %lld of %@ is also used by another response (%@). It keeps the original file: only this one will use the new file."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El canal %lld de %@ también lo usa otra respuesta (%@). Esta conserva el archivo original: solo esta usará el nuevo archivo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il canale %lld di %@ è usato anche da un'altra risposta (%@). Questa mantiene il file originale: solo questa userà il nuovo file."
          }
        }
      }
    },
    "La voie %lld n'est pas dans le fichier, qui en a %lld." : {
      "localizations" : {
        "de" : {

    "Repères trouvés dans le fichier, dans le domaine temporel : le début de l'attaque est à −60 dB sous la crête, la fin utile à −90 dB." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Zeitbereich in der Datei gefundene Marken: Der Beginn des Einsatzes liegt bei −60 dB unter der Spitze, das nutzbare Ende bei −90 dB."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markers found in the file, in the time domain: the start of the attack is at −60 dB below the peak, the useful end at −90 dB."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marcas encontradas en el archivo, en el dominio del tiempo: el inicio del ataque está a −60 dB por debajo del pico, el fin útil a −90 dB."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riferimenti trovati nel file, nel dominio del tempo: l'inizio dell'attacco è a −60 dB sotto il picco, la fine utile a −90 dB."
          }
        }
      }
    },

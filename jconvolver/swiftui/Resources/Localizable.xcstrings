    "Plus elle est grande, moins le processeur travaille, mais plus la latence augmente." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je größer sie ist, desto weniger arbeitet der Prozessor, aber desto größer wird die Latenz."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The larger it is, the less the processor works, but the more the latency grows."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuanto mayor es, menos trabaja el procesador, pero más aumenta la latencia."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Più è grande, meno lavora il processore, ma più aumenta la latenza."

          "stringUnit" : {
            "state" : "translated",
            "value" : "Middle slides it, an end changes scale (the other stays)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El centro la desliza, un extremo cambia la escala (el otro se mantiene)"

    "Le milieu le fait glisser, une extrémité change l'échelle (l'autre reste)" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Mitte verschiebt sie, ein Ende ändert den Maßstab (das andere bleibt)"
          }
        },

    "Chaque ligne correspond à une réponse impulsionnelle. Réglage rapide du gain et des paramètres temporels." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Zeile entspricht einer Impulsantwort. Schnelle Einstellung von Gain und Zeitparametern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each row is an impulse response. Quick setting of the gain and the time parameters."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada fila corresponde a una respuesta al impulso. Ajuste rápido de la ganancia y de los parámetros de tiempo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni riga corrisponde a una risposta all'impulso. Impostazione rapida del guadagno e dei parametri temporali."
          }
        }
      }
    },
    "Chaque voie de jconvolver se relie à des ports d'autres applications." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder jconvolver-Kanal wird mit Ports anderer Anwendungen verbunden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each jconvolver channel is connected to ports of other applications."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada canal de jconvolver se conecta a puertos de otras aplicaciones."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni canale di jconvolver si collega a porte di altre applicazioni."
          }

    "Le moteur reste en cours d'exécution dans JACK jusqu'à ce que vous l'arrêtiez : ses entrées et ses sorties sont des ports JACK." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Engine läuft in JACK weiter, bis du sie anhältst: Ihre Ein- und Ausgänge sind JACK-Ports."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The engine keeps running in JACK until you stop it: its inputs and outputs are JACK ports."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El motor sigue en ejecución en JACK hasta que lo detengas: sus entradas y salidas son puertos JACK."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il motore resta in esecuzione in JACK finché non lo fermi: i suoi ingressi e le sue uscite sono porte JACK."
          }
        }
      }
    },
    "Le moteur s'est arrêté" : {

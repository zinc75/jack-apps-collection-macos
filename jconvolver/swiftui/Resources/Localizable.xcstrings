    "Retire de la phase le retard (la droite qu'elle dessine) : ce qui reste est la phase du système lui-même." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entfernt die Verzögerung (die Gerade, die sie zeichnet) aus der Phase: Was bleibt, ist die Phase des Systems selbst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Removes the delay (the straight line it draws) from the phase: what is left is the phase of the system itself."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quita de la fase el retardo (la recta que dibuja): lo que queda es la fase del propio sistema."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuove dalla fase il ritardo (la retta che disegna): ciò che resta è la fase del sistema stesso."
          }
        }
      }
    },

      }
    },
    "Charge audio de JACK : la part du temps d'une période que le traitement prend. Orange à partir de 70 %, rouge à partir de 90 % : au-delà, les coupures (xruns) arrivent." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JACK-Audiolast: der Anteil der Periodendauer, den die Verarbeitung benötigt. Orange ab 70 %, rot ab 90 %: Darüber treten Aussetzer (Xruns) auf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JACK audio load: the share of a period's time that processing takes. Orange from 70%, red from 90%: beyond that, dropouts (xruns) occur."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carga de audio de JACK: la parte del tiempo de un periodo que ocupa el procesamiento. Naranja a partir del 70 %, rojo a partir del 90 %: más allá se producen cortes (xruns)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carico audio di JACK: la parte del tempo di un periodo occupata dall'elaborazione. Arancione dal 70 %, rosso dal 90 %: oltre, si verificano interruzioni (xrun)."
          }
        }
      }
    },

+void Jclient::connect_input (const char *name, const char *conn)
+{
+    char s [512];
+
+    snprintf (s, sizeof (s), "%s:%s", _jname, name);
+    jack_connect (_jack_client, conn, s);
+}
+
+
+void Jclient::connect_output (const char *name, const char *conn)
+{
+    char s [512];
+
+    snprintf (s, sizeof (s), "%s:%s", _jname, name);
+    jack_connect (_jack_client, s, conn);
 }
 

+#ifdef __APPLE__
+// On macOS the SCHED_FIFO attributes that Convproc gives to its computation threads are accepted but leave
+// them in the time sharing band, and under load they run late. JACK gives its own threads a time constraint
+// derived from its period; ask it to do the same for these.
+void Jclient::thread_init (void *arg, uint32_t)
+{
+    Jclient *C = (Jclient *) arg;
+
+    if (jack_client_real_time_priority (C->_jack_client) >= 0)
+    {
+        jack_acquire_real_time_scheduling (pthread_self (), C->_abspri);
+    }
+}
+#endif
+
